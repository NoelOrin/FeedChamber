# Feed Chamber 环境变量样例
#
#   cp .env.example .env
#
# docker-compose.yml 里所有变量都有默认值，
# 不建这个文件也能 up。这里列出的是**建议显式配置**的项——尤其是标 ⚠ 的。

# ── 入口 ──────────────────────────────────────────────────────────────
# 宿主机 HTTP 端口（仅 docker-compose.yml 用；平台托管部署由 ingress 接管 80/443）
HTTP_PORT=80

# ── 数据库（PostgreSQL）────────────────────────────────────────────────
# 三个变量同时决定 postgres 容器的初始化与 backend 的 DB_DSN，必须一致。
# ⚠ 生产务必改 POSTGRES_PASSWORD，默认值 feedchamber 只适合本地。
POSTGRES_USER=feedchamber
POSTGRES_PASSWORD=feedchamber
POSTGRES_DB=feedchamber

# ── 初始管理员 ────────────────────────────────────────────────────────
# 留空则后端随机生成并打印到容器日志：
#   docker compose -f deploy/docker-compose.yml logs backend | grep -i admin
# ⚠ 生产建议显式设置，避免从日志里捞密码。
ADMIN_PASSWORD=

# ── 站点 URL ──────────────────────────────────────────────────────────
# sitemap / robots.txt / canonical / OG 的域名来源。
# 优先级：后台「站点信息 → 网站 URL」的 settings 值 > 本变量 > 空。
# ⚠ 生产必须配，否则这些产出会写 http://localhost:8080，搜索引擎拒绝收录。
SITE_URL=https://forum.example.com

# ── 会话 cookie 安全位 ────────────────────────────────────────────────
# master_session 是唯一凭证，Secure=true 时只在 HTTPS 下发送。
# compose 里默认已是 true（容器部署必然在反代之后，对外就是 HTTPS），
# 这一行只是显式化；留空则沿用 compose 的 true。
# 只有本地 http 直连 backend 调试时才需要改成 false。
MASTER_COOKIE_SECURE=true

# ── 日志 ──────────────────────────────────────────────────────────────
# LOG_LEVEL: debug / info / warn / error
# LOG_FORMAT: json / text
# LOG_OUTPUT: stdout / stderr / 文件路径（文件打不开时回退 stderr）
LOG_LEVEL=info
LOG_FORMAT=json
LOG_OUTPUT=stderr

# ── 构建期（依赖源，国内网络可改）─────────────────────────────────────
# GOPROXY=https://goproxy.cn,direct
# NPM_REGISTRY=https://registry.npmmirror.com

# ── 以下一般不用改（compose 里已写死或已有合理默认）────────────────────
#
# NATS_URL / NATS_BUCKET   外部 NATS 地址与 KV bucket。compose 内为 nats://nats:4222。
#                          若改用外部 NATS，需启用 JetStream（-js）。
# DB_TYPE / DB_DSN         由 compose 依据上面 POSTGRES_* 拼出，不必单独设。
# METRICS_ENABLED/PORT     指标端点，默认 9091，仅容器网络内可达。
# TRACING_ENABLED          是否解析入站 traceparent，默认 true。
# DB_MAX_OPEN_CONNS=25     连接池（另有 IDLE_CONNS / CONN_MAX_LIFETIME / CONN_MAX_IDLE_TIME）
# STORAGE_TYPE=local       local / s3；s3 另需 S3_ENDPOINT / BUCKET / REGION / ACCESS_KEY / SECRET_KEY
