{
	"$schema": "https://turbo.build/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
			"outputs": ["dist/**", ".output/**", "app/docs/dist/**"]
		},
		"dev": {
			"dependsOn": ["^build"],
			"cache": false,
			"persistent": true
		},
		"lint": {},
		"lint:fix": {},
		"check": {},
		"format": {},
		"format:check": {},
		"preview": {},
		"start": {},
		"test": {
			"dependsOn": ["^build"]
		}
	}
}
