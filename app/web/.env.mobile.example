# OrinForum Mobile 配置
# 复制到 .env.mobile 并按需修改

# 开发服务器地址（HMR 模式）
# - 设置后：原生壳加载此 URL，支持 Vite HMR 热重载
# - 不设置（或留空）：原生壳加载打包进 app 的静态资源（生产模式）
# 局域网 IP 可通过 `ifconfig | grep "inet " | grep -v 127.0.0.1` 查看
MOBILE_SERVER_URL=http://192.168.8.3:3000

# App 唯一标识（反向域名，发布后不可更改）
CAPACITOR_APP_ID=com.orinforum.app

# App 显示名称（出现在桌面图标下方）
CAPACITOR_APP_NAME=OrinForum

# iOS 开发团队 ID（签名用，可从 Xcode → 偏好设置 → 账户 查看）
# 留空则 Xcode 自动签名
IOS_DEV_TEAM=

# Android 密钥库路径（发布签名用，开发调试可忽略）
# ANDROID_KEYSTORE_PATH=
# ANDROID_KEYSTORE_PASSWORD=
# ANDROID_KEY_ALIAS=
# ANDROID_KEY_PASSWORD=
