{
	"name": "@feedchamber/docs",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"predev": "node scripts/sync-openapi.mjs && node scripts/gen-reference.mjs",
		"dev": "astro dev",
		"prebuild": "node scripts/sync-openapi.mjs && node scripts/gen-reference.mjs",
		"build": "astro build",
		"preview": "astro preview",
		"sync": "node scripts/sync-openapi.mjs",
		"sync:reference": "node scripts/gen-reference.mjs",
		"sync:reference:check": "node scripts/gen-reference.mjs --check",
		"lint": "biome lint ./src ./astro.config.mjs ./scripts",
		"format": "biome format ./src ./astro.config.mjs ./scripts",
		"check": "astro sync && tsc --noEmit && biome check ./src ./astro.config.mjs ./scripts",
		"typecheck": "astro sync && tsc --noEmit",
		"astro:sync": "astro sync"
	},
	"dependencies": {
		"@astrojs/markdown-remark": "^7.3.5",
		"@astrojs/starlight": "^0.42.7",
		"astro": "^7.4.4"
	},
	"devDependencies": {
		"typescript": "~5.9.3"
	}
}
