{
	"name": "feedchamber",
	"description": "Self-hosted community forum: Go + Iris backend, React 19 frontend, MCP-capable.",
	"private": true,
	"license": "MIT",
	"packageManager": "pnpm@10.26.2",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/NoelOrin/FeedChamber.git"
	},
	"homepage": "https://noelorin.github.io/FeedChamber/",
	"bugs": {
		"url": "https://github.com/NoelOrin/FeedChamber/issues"
	},
	"keywords": [
		"forum",
		"community",
		"go",
		"iris",
		"react",
		"nats",
		"mcp"
	],
	"scripts": {
		"build": "turbo run build --filter='./packages/*' --filter='./app/*' --filter='!@feedchamber/server'",
		"build:server": "pnpm --filter @feedchamber/server build",
		"build:all": "turbo run build --filter='./packages/*' --filter='./app/*' && pnpm build:server",
		"dev:web": "turbo run dev --filter=@feedchamber/web...",
		"dev:server": "pnpm --filter @feedchamber/server dev",
		"build:web": "turbo run build --filter=@feedchamber/web...",
		"build:docker": "docker compose -f deploy/docker-compose.yml build",
		"lint": "turbo run lint",
		"format": "turbo run format",
		"check": "turbo run check",
		"dev:docs": "turbo run dev --filter=@feedchamber/docs",
		"build:docs": "turbo run build --filter=@feedchamber/docs"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.0",
		"@commitlint/cli": "^19.0.0",
		"@commitlint/config-conventional": "^19.0.0",
		"lefthook": "^1.10.0",
		"playwright": "1.62.1",
		"turbo": "^2.9.16"
	}
}
